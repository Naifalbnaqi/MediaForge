# MediaForge — production environment template.
#
# Every value below is a PLACEHOLDER. Copy the variable NAMES into your platform's secret
# store / environment configuration; never commit real values, and never bake them into an
# image. See docs/PRODUCTION.md for what each one means and how to provision it.
# Secrets are marked [SECRET].

NODE_ENV=production

# --- Public origins (required in production; no localhost fallback) ------------------
# Exact browser origins of the customer and admin apps. Used for CORS and bucket CORS.
WEB_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://app.example.com

# --- HTTP / proxy ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Reverse proxies between the internet and the API: 1 = one proxy (nginx or a load
# balancer), 2 = load balancer in front of nginx. Too low collapses every user into one
# rate-limit bucket; too high trusts client-supplied X-Forwarded-For entries.
TRUST_PROXY_HOPS=1
# Empty = host-only cookie. Set only to share cookies across subdomains.
COOKIE_DOMAIN=
# Leave unset (defaults to secure cookies in production) or set true. Never false on a
# real HTTPS deployment.
COOKIE_SECURE=true

# --- Build-time (web image build args, inlined into the browser bundle) ---------------
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_ADMIN_URL=/admin

# --- PostgreSQL (managed) -------------------------------------------------------------
# [SECRET] Include ?sslmode=require (or verify-full) for a managed service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require

# --- Redis (managed; must use the noeviction policy for BullMQ) -----------------------
# [SECRET] Use rediss:// for TLS.
REDIS_URL=rediss://:PASSWORD@HOST:6379

# --- Auth ------------------------------------------------------------------------------
# [SECRET] Two independent random values, at least 32 characters each. Startup fails if
# they are equal. Generate with e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- S3-compatible object storage ------------------------------------------------------
# One endpoint reachable both server-side and from browsers (the normal cloud case), so
# S3_PUBLIC_ENDPOINT stays unset. Keep the bucket private.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
# [SECRET]
S3_ACCESS_KEY=
# [SECRET]
S3_SECRET_KEY=
# false when bucket CORS is provisioned outside the app (recommended); true lets the API
# apply it with PutBucketCors on first use (needs that IAM permission).
S3_MANAGE_BUCKET_CORS=false

# --- Limits and tuning -----------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=524288000
UPLOAD_URL_TTL_SECONDS=900
PENDING_UPLOAD_GRACE_SECONDS=300
MAX_ACTIVE_JOBS_PER_USER=3

# --- Worker only -----------------------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
LIBREOFFICE_PATH=soffice
WORKER_HEALTH_PORT=4001
# Jobs one worker process runs at once (CPU-bound work; scale out with more replicas).
WORKER_CONCURRENCY=2

LOG_LEVEL=info
