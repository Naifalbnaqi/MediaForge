    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@media/config": "*",
    "@media/database": "*",
    "@media/types": "*",
    "@media/validation": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
