NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
DATABASE_URL=postgresql://media:media_dev_password@localhost:5432/media_platform?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# Controls the Secure attribute on auth cookies. Leave unset to default to
# NODE_ENV === 'production' (secure cookies). Set explicitly to false for local
# Docker/HTTP development (e.g. NODE_ENV=production served over http://localhost),
# and to true for production HTTPS deployments.
COOKIE_SECURE=false
# S3_ENDPOINT: used by the API/worker for server-side storage access (bucket
# management, download/upload streaming, existence checks).
# - Running apps/api directly on the host (this file's default): the same
#   http://localhost:9000 MinIO endpoint works for both server-side and browser
#   access, so S3_PUBLIC_ENDPOINT below can be left unset.
# - Running via `docker compose up` (see docker-compose.yml): the api/worker
#   containers use the Docker-internal hostname http://object-storage:9000 instead,
#   which a browser on the host cannot reach — that's what S3_PUBLIC_ENDPOINT is for.
# - Production (AWS S3 or another S3-compatible provider): a real HTTPS endpoint,
#   e.g. https://s3.us-east-1.amazonaws.com or your provider's HTTPS endpoint.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT: endpoint embedded in presigned upload/download URLs handed to
# the browser. Leave unset to fall back to S3_ENDPOINT (the common case — a real
# HTTPS deployment typically uses the same reachable endpoint for both). Only needs
# to differ locally under Docker Compose, where it's set to http://localhost:9000
# so the browser can reach MinIO even though the API reaches it via
# http://object-storage:9000. Never hardcode "localhost" in application code — this
# is purely an environment-specific config value.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=media-platform
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key
# Whether this application manages the bucket's CORS rules itself via the S3 API
# (PutBucketCorsCommand). Defaults to true (matches the pre-existing behavior) when
# unset. Set to false when CORS is managed externally instead — e.g. locally via
# MinIO's own MINIO_API_CORS_ALLOW_ORIGIN (see docker-compose.yml), or in production
# when your S3-compatible provider's console/API manages bucket CORS directly. Set
# to true if you want this application to manage CORS through the S3 API itself
# (e.g. a real AWS S3 bucket with no CORS configured elsewhere).
S3_MANAGE_BUCKET_CORS=true
# Max accepted upload size in bytes (default: 500 MiB)
MAX_UPLOAD_SIZE_BYTES=524288000
# How long a presigned upload URL stays valid, in seconds (default: 15 minutes). Also
# the basis the stale-upload reconciliation worker uses to decide when an abandoned
# PENDING upload is safe to act on — keep this in sync with reality, not just tune it
# for signing. Reaching this TTL alone does NOT prove no PUT is still in flight (see
# PENDING_UPLOAD_GRACE_SECONDS below) — the worker never treats it that way.
UPLOAD_URL_TTL_SECONDS=900
# Extra buffer, in seconds, added on top of UPLOAD_URL_TTL_SECONDS before the
# stale-upload reconciliation worker treats a PENDING or manually-cancelled upload as
# truly safe to cancel / physically delete from storage. A presigned PUT's signature
# is validated by S3/MinIO only when the request is first accepted, not continuously
# through the body transfer, so a PUT that started just under the TTL wire can still
# be landing bytes after it technically expires — this margin covers that gap for
# both the stale-PENDING sweep and the deferred cleanup of a manual cancel's storage
# object (default: 5 minutes).
PENDING_UPLOAD_GRACE_SECONDS=300
# Most jobs a single user may have QUEUED+PROCESSING at once (default: 3). A
# server-side abuse/fairness guard, enforced only by the API process — see
# ProcessingService.enforceActiveJobLimit.
MAX_ACTIVE_JOBS_PER_USER=3
FFMPEG_PATH=ffmpeg
# Only the worker runs LibreOffice (document-to-pdf); the API never invokes it.
LIBREOFFICE_PATH=soffice
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 when the browser talks to it
# directly, as in `npm run dev`). Only the X-Forwarded-For entries those proxies append
# are trusted for per-IP rate limiting; see docs/PRODUCTION.md before changing it.
TRUST_PROXY_HOPS=0
# Port of the worker's private health endpoint (/health/live, /health/ready); 0 disables.
WORKER_HEALTH_PORT=4001
# Jobs one worker process runs at once (media work is CPU-bound; scale out with replicas).
WORKER_CONCURRENCY=2

